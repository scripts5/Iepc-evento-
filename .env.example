# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Secret key for signing admin authentication tokens and session security
ADMIN_SESSION_SECRET="change-this-secret-in-production-key-92837482"

# Configurações de SMTP para envio programático de e-mails com comprovante e QR Code
# Exemplo 1: Gmail (usando Senha de App de 16 dígitos)
# GMAIL_USER="seu-email@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Exemplo 2: SMTP Dedicado (SendGrid, Mailgun, Amazon SES, Locaweb, etc.)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app"
# SMTP_FROM="Conferência de Jovens IEPC <eventos@iepc.com.br>"


